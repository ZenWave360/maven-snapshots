  <groupId>io.zenwave360.language</groupId>
  <artifactId>lsp-jvm</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>ZenWave LSP JVM</name>
  <description>JVM LSP4J transport for the ZenWave shared language server core</description>
  <url>https://github.com/ZenWave360/zenwave-lsp</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ivangsa</id>
      <name>Ivan Garcia Sainz-Aja</name>
      <email>ivangsa@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ZenWave360/zenwave-lsp.git</connection>
    <developerConnection>scm:git:ssh://github.com/ZenWave360/zenwave-lsp.git</developerConnection>
    <url>https://github.com/ZenWave360/zenwave-lsp</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib-jdk8</artifactId>
        <version>2.3.0</version>
      </dependency>
