<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.zenwave360.architecture</groupId>
  <artifactId>architecture-manifest-js</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>klib</packaging>
  <name>ZenWave Architecture Manifest</name>
  <description>Shared manifest parsing and loading library for ZenWave workspace tooling</description>
  <url>https://github.com/ZenWave360/zenwave-architecture</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ivangsa</id>
      <name>Ivan Garcia Sainz-Aja</name>
      <email>ivangsa@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/ZenWave360/zenwave-architecture.git</connection>
    <developerConnection>scm:git:ssh://github.com/ZenWave360/zenwave-architecture.git</developerConnection>
    <url>https://github.com/ZenWave360/zenwave-architecture</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib-common</artifactId>
        <version>2.3.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-dom-api-compat</artifactId>
      <version>2.3.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib-js</artifactId>
      <version>2.3.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib-common</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.zenwave360.jsonrefparser</groupId>
      <artifactId>json-schema-ref-parser-kmp-js</artifactId>
      <version>0.9.24</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
